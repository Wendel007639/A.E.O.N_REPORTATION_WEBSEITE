{
  "name": "aeon-reportation-webseite",
  "version": "0.2.0",
  "private": true,
  "description": "A.E.O.N Reportation- und Beweis-Webseite fuer ProofKit, Evidence-Briefs, Artefakte, Learning, Speed und Investor-Kommunikation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "webdev": "next dev",
    "webbuild": "next build",
    "weblint": "eslint .",
    "webstatus": "git status --short",
    "webproof": "cat src/data/latest-proof.json",
    "check:structure": "node scripts/check-structure.mjs",
    "check:json": "node scripts/check-json.mjs",
    "check": "npm run check:structure && npm run check:json && npm run check:proof-data && npm run check:download-data && npm run check:surface && npm run weblint && npm run webbuild",
    "check:proof-data": "node scripts/check-proof-data.mjs",
    "check:download-data": "node scripts/check-download-data.mjs",
    "check:surface": "node scripts/check-surface-reliability.mjs"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest"
  }
}
