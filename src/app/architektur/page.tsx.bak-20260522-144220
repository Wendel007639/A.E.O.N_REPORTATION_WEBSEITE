      : [
          ["VERTRAUEN", "Transparent", "Menschlich", "Verbunden"],
          ["VERBUNDENHEIT", "Grenzenlos", "Vernetzt", "Zukunft"],
          ["KERNWERTE", "Proof", "Guard", "Nexus"],
        ];

  return (
    <div
      className={`${styles.signalRail} ${
        side === "left" ? styles.leftRail : styles.rightRail
      }`}
      aria-hidden="true"
    >
      {signals.map(([title, ...lines], index) => (
        <div
          className={styles.signalCard}
          key={title}
          style={{ "--delay": `${index * 0.14}s` } as CSSProperties}
        >
          <span className={styles.signalTitle}>{title}</span>
          {lines.map((line) => (
            <span className={styles.signalLine} key={line}>
              {line}
            </span>
          ))}
          <span className={styles.signalBar}>
            <span />
          </span>
          <small>100%</small>
        </div>
      ))}
    </div>
  );
}

