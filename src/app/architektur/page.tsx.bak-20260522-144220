function SignalRail({ side }: { side: "left" | "right" }) {
  const signals =
    side === "left"
      ? [
          ["INTELLIGENZ", "Kontext", "Analyse", "Führung"],
          ["WISSEN", "Daten", "Verstehen", "Fortschritt"],
          ["SCHUTZ", "Sicher", "Ethisch", "Verlässlich"],
