.architecturePage {
  --aeon-bg: #020714;
  --aeon-panel: rgba(3, 14, 31, 0.76);
  --aeon-panel-strong: rgba(5, 22, 48, 0.92);
  --aeon-cyan: #00eaff;
  --aeon-blue: #1577ff;
  --aeon-deep: #061a3d;
  --aeon-text: #e8fbff;
  --aeon-muted: rgba(206, 245, 255, 0.68);
  --aeon-line: rgba(0, 234, 255, 0.38);
  --aeon-danger: rgba(255, 82, 152, 0.72);

  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: var(--aeon-text);
  background:
    radial-gradient(circle at 50% 4%, rgba(0, 234, 255, 0.28), transparent 30rem),
    radial-gradient(circle at 50% 44%, rgba(21, 119, 255, 0.22), transparent 38rem),
    radial-gradient(circle at 12% 18%, rgba(0, 234, 255, 0.12), transparent 28rem),
    linear-gradient(180deg, #01040b 0%, #031024 44%, #020714 100%);
  isolation: isolate;
}

.architecturePage::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(rgba(0, 234, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 234, 255, 0.05) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: radial-gradient(circle at center, black 0%, transparent 74%);
  opacity: 0.7;
  z-index: -3;
}

.architecturePage::after {
  content: "";
  position: absolute;
  inset: -30%;
  pointer-events: none;
  background:
    repeating-conic-gradient(
      from 0deg,
      rgba(0, 234, 255, 0.14) 0deg 1deg,
      transparent 1deg 8deg
    );
  animation: slowRotate 34s linear infinite;
  opacity: 0.12;
  z-index: -4;
}

.noiseLayer,
.scanLayer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.noiseLayer {
  background-image:
    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px),
    radial-gradient(circle at 80% 30%, rgba(0, 234, 255, 0.1) 0 1px, transparent 1px);
  background-size: 71px 89px, 113px 97px;
  opacity: 0.22;
  mix-blend-mode: screen;
}

.scanLayer {
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(0, 234, 255, 0.08) 50%,
    transparent 100%
  );
  height: 18rem;
  animation: scanMove 7s ease-in-out infinite;
  opacity: 0.42;
}

.inner {
  position: relative;
  z-index: 1;
  width: min(1440px, calc(100% - clamp(1.5rem, 4vw, 5rem)));
  margin: 0 auto;
  padding: clamp(3.5rem, 6vw, 6.5rem) 0;
}

.hero {
  display: grid;
  grid-template-columns: minmax(18rem, 0.92fr) minmax(36rem, 1.35fr);
  gap: clamp(2rem, 5vw, 5.5rem);
  align-items: center;
  min-height: min(860px, calc(100vh - 4rem));
}

.heroCopy {
  position: relative;
  padding: clamp(1rem, 2vw, 2rem);
}

.eyebrow,
.sectionHeader p,
.proofIntro p,
.guardCore p {
  margin: 0 0 1rem;
  color: var(--aeon-cyan);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  text-shadow: 0 0 18px rgba(0, 234, 255, 0.72);
}

.heroCopy h1,
.sectionHeader h2,
.proofIntro h2,
.guardCore h2 {
  margin: 0;
  font-weight: 900;
  line-height: 0.94;
  letter-spacing: -0.06em;
  text-transform: uppercase;
}

.heroCopy h1 {
  max-width: 13ch;
  font-size: clamp(3.3rem, 8vw, 7.8rem);
  text-shadow:
    0 0 22px rgba(0, 234, 255, 0.42),
    0 0 58px rgba(21, 119, 255, 0.28);
}

.heroLead {
  max-width: 44rem;
  margin: 1.6rem 0 0;
  color: var(--aeon-muted);
  font-size: clamp(1rem, 1.5vw, 1.24rem);
  line-height: 1.78;
}

.heroActions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin-top: 2rem;
}

.primaryAction,
.secondaryAction {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 3.15rem;
  padding: 0 1.35rem;
  color: var(--aeon-text);
  font-size: 0.8rem;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-decoration: none;
  text-transform: uppercase;
  border: 1px solid var(--aeon-line);
  clip-path: polygon(9% 0, 100% 0, 100% 70%, 91% 100%, 0 100%, 0 30%);
}

.primaryAction {
  background:
    linear-gradient(90deg, rgba(0, 234, 255, 0.22), rgba(21, 119, 255, 0.34)),
    rgba(2, 18, 39, 0.9);
  box-shadow:
    inset 0 0 20px rgba(0, 234, 255, 0.28),
    0 0 34px rgba(0, 234, 255, 0.22);
}

.secondaryAction {
  background: rgba(2, 14, 31, 0.68);
}

.guardNotice {
  position: relative;
  margin-top: 2rem;
  padding: 1rem 1rem 1rem 1.1rem;
  border: 1px solid rgba(0, 234, 255, 0.2);
  background:
    linear-gradient(90deg, rgba(0, 234, 255, 0.12), transparent),
    rgba(1, 8, 19, 0.62);
  box-shadow: inset 0 0 26px rgba(0, 234, 255, 0.1);
}

.guardNotice::before {
  content: "";
  position: absolute;
  inset: -1px auto -1px -1px;
  width: 4px;
  background: var(--aeon-cyan);
  box-shadow: 0 0 18px var(--aeon-cyan);
}

.guardNotice span,
.guardNotice strong {
  display: inline-flex;
  margin-right: 0.75rem;
  color: var(--aeon-cyan);
  font-size: 0.75rem;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.guardNotice p {
  margin: 0.55rem 0 0;
  color: var(--aeon-muted);
  line-height: 1.65;
}

.nexusVisual {
  position: relative;
  min-height: clamp(40rem, 62vw, 54rem);
}

.coreStage {
  position: absolute;
  inset: 0 13%;
  display: grid;
  place-items: center;
  perspective: 1000px;
}

.energyBurst {
  position: absolute;
  width: min(54vw, 48rem);
  aspect-ratio: 1;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(0, 234, 255, 0.36) 0 2%, transparent 3%),
    repeating-conic-gradient(
      from 0deg,
      rgba(0, 234, 255, 0.5) 0deg 1deg,
      transparent 1deg 9deg
    );
  filter: blur(0.4px) drop-shadow(0 0 38px rgba(0, 234, 255, 0.42));
  mask-image: radial-gradient(circle, transparent 0 12%, black 14% 56%, transparent 70%);
  animation: pulse 4s ease-in-out infinite;
}

.floorGrid {
  position: absolute;
  bottom: 7%;
  width: 105%;
  height: 34%;
  transform: rotateX(72deg);
  transform-origin: center bottom;
  border-radius: 50%;
  background:
    radial-gradient(ellipse at center, rgba(0, 234, 255, 0.26), transparent 58%),
    repeating-radial-gradient(ellipse at center, rgba(0, 234, 255, 0.36) 0 1px, transparent 2px 28px),
    linear-gradient(90deg, transparent 49%, rgba(0, 234, 255, 0.32) 50%, transparent 51%);
  box-shadow:
    0 0 58px rgba(0, 234, 255, 0.3),
    inset 0 0 48px rgba(21, 119, 255, 0.28);
  opacity: 0.72;
}

.orbitOne,
.orbitTwo,
.orbitThree {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(0, 234, 255, 0.46);
  box-shadow:
    inset 0 0 28px rgba(0, 234, 255, 0.18),
    0 0 32px rgba(21, 119, 255, 0.24);
}

.orbitOne {
  width: min(45vw, 37rem);
  aspect-ratio: 1;
  animation: slowRotate 19s linear infinite;
}

.orbitTwo {
  width: min(36vw, 29rem);
  aspect-ratio: 1;
  border-style: dashed;
  animation: reverseRotate 23s linear infinite;
}

.orbitThree {
  width: min(27vw, 22rem);
  aspect-ratio: 1;
  border-color: rgba(255, 255, 255, 0.48);
  animation: slowRotate 15s linear infinite;
}

.corePanel {
  position: relative;
  display: grid;
  place-items: center;
  width: min(31vw, 26rem);
  min-width: 19rem;
  aspect-ratio: 1;
  border: 1px solid rgba(0, 234, 255, 0.55);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 46%, rgba(0, 234, 255, 0.24), transparent 31%),
    radial-gradient(circle, rgba(2, 9, 22, 0.28), rgba(2, 9, 22, 0.94) 62%),
    rgba(2, 10, 23, 0.86);
  box-shadow:
    inset 0 0 44px rgba(0, 234, 255, 0.22),
    inset 0 0 110px rgba(21, 119, 255, 0.16),
    0 0 78px rgba(0, 234, 255, 0.4);
}

.coreHalo {
  position: absolute;
  inset: 10%;
  border: 3px solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  box-shadow:
    0 0 24px rgba(255, 255, 255, 0.46),
    0 0 44px rgba(0, 234, 255, 0.44);
  opacity: 0.54;
}

.coreBrain {
  position: absolute;
  top: 22%;
  width: 44%;
  aspect-ratio: 1.25;
  border: 2px solid var(--aeon-cyan);
  border-radius: 44% 44% 38% 38%;
  box-shadow:
    inset 0 0 18px rgba(0, 234, 255, 0.32),
    0 0 24px rgba(0, 234, 255, 0.56);
}

.coreBrain::before,
.coreBrain::after {
  content: "";
  position: absolute;
  top: 9%;
  bottom: 9%;
  width: 48%;
  border: 2px solid rgba(0, 234, 255, 0.78);
}

.coreBrain::before {
  left: 4%;
  border-right: 0;
  border-radius: 55% 0 0 45%;
}

.coreBrain::after {
  right: 4%;
  border-left: 0;
  border-radius: 0 55% 45% 0;
}

.coreBrain span {
  position: absolute;
  width: 0.42rem;
  aspect-ratio: 1;
  border-radius: 50%;
  background: var(--aeon-cyan);
  box-shadow: 0 0 16px var(--aeon-cyan);
}

.coreBrain span:nth-child(1) {
  left: 19%;
  top: 24%;
}

.coreBrain span:nth-child(2) {
  right: 18%;
  top: 32%;
}

.coreBrain span:nth-child(3) {
  left: 36%;
  bottom: 21%;
}

.coreBrain span:nth-child(4) {
  right: 34%;
  bottom: 18%;
}

.coreTitle {
  position: absolute;
  bottom: 25%;
  display: grid;
  gap: 0.35rem;
  text-align: center;
}

.coreTitle span {
  font-size: clamp(2rem, 4vw, 4.2rem);
  font-weight: 1000;
  letter-spacing: 0.18em;
  line-height: 0.9;
  text-shadow:
    0 0 18px rgba(0, 234, 255, 0.54),
    0 0 36px rgba(21, 119, 255, 0.44);
}

.coreTitle strong {
  color: var(--aeon-cyan);
  font-size: 0.72rem;
  letter-spacing: 0.55em;
  text-indent: 0.55em;
  text-transform: uppercase;
}

.nodeDock {
  position: absolute;
  bottom: 9%;
  display: flex;
  gap: 0.35rem;
  max-width: 92%;
  padding: 0.55rem;
  border: 1px solid rgba(0, 234, 255, 0.24);
  background: rgba(0, 7, 18, 0.72);
  clip-path: polygon(5% 0, 95% 0, 100% 30%, 100% 72%, 94% 100%, 6% 100%, 0 72%, 0 30%);
}

.nodeDock span {
  padding: 0.35rem 0.42rem;
  color: rgba(232, 251, 255, 0.82);
  font-size: clamp(0.45rem, 0.65vw, 0.62rem);
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-left: 1px solid rgba(0, 234, 255, 0.22);
}

.nodeDock span:first-child {
  border-left: 0;
}

.hexTop,
.hexLeft,
.hexRight,
.hexBottom {
  position: absolute;
  display: grid;
  place-items: center;
  width: clamp(4rem, 7vw, 6.4rem);
  aspect-ratio: 1.14;
  color: var(--aeon-cyan);
  font-size: 0.78rem;
  font-weight: 1000;
  letter-spacing: 0.18em;
  border: 1px solid rgba(0, 234, 255, 0.58);
  background:
    linear-gradient(135deg, rgba(0, 234, 255, 0.12), rgba(21, 119, 255, 0.08)),
    rgba(2, 10, 24, 0.82);
  clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
  box-shadow:
    inset 0 0 22px rgba(0, 234, 255, 0.16),
    0 0 24px rgba(0, 234, 255, 0.26);
}

.hexTop {
  top: 8%;
}

.hexLeft {
  left: 6%;
  top: 42%;
}

.hexRight {
  right: 6%;
  top: 42%;
}

.hexBottom {
  bottom: 8%;
  font-size: 1.7rem;
}

.signalRail {
  position: absolute;
  top: 15%;
  z-index: 2;
  display: grid;
  gap: 1rem;
  width: clamp(11rem, 15vw, 15.5rem);
}

.leftRail {
  left: 0;
}

.rightRail {
  right: 0;
}

.signalCard {
  position: relative;
  padding: 1rem 1rem 0.85rem;
  min-height: 8.2rem;
  color: var(--aeon-cyan);
  border: 1px solid rgba(0, 234, 255, 0.42);
  background:
    linear-gradient(90deg, rgba(0, 234, 255, 0.12), transparent),
    rgba(1, 9, 23, 0.78);
  clip-path: polygon(9% 0, 100% 0, 100% 76%, 91% 100%, 0 100%, 0 24%);
  box-shadow:
    inset 0 0 18px rgba(0, 234, 255, 0.14),
    0 0 24px rgba(0, 234, 255, 0.16);
  animation: panelFloat 4.6s ease-in-out infinite;
  animation-delay: var(--delay);
}

.signalCard::before,
.signalCard::after {
  content: "";
  position: absolute;
  inset: 0.38rem;
  pointer-events: none;
  border: 1px solid rgba(0, 234, 255, 0.25);
  clip-path: inherit;
}

.signalCard::after {
  inset: auto 0.9rem 0.9rem;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--aeon-cyan), transparent);
  border: 0;
  box-shadow: 0 0 14px var(--aeon-cyan);
}

.signalTitle,
.signalLine {
  display: block;
  text-transform: uppercase;
}

.signalTitle {
  margin-bottom: 0.8rem;
  font-size: 0.92rem;
  font-weight: 1000;
  letter-spacing: 0.14em;
}

.signalLine {
  color: rgba(194, 249, 255, 0.82);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  line-height: 1.75;
}

.signalBar {
  position: absolute;
  left: 1rem;
  right: 4.5rem;
  bottom: 1rem;
  height: 0.48rem;
  overflow: hidden;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(0, 234, 255, 0.9) 0 2px,
      transparent 2px 5px
    );
  box-shadow: 0 0 12px rgba(0, 234, 255, 0.7);
}

.signalBar span {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, rgba(0, 234, 255, 0.1), rgba(0, 234, 255, 0.5));
}

.signalCard small {
  position: absolute;
  right: 1rem;
  bottom: 0.78rem;
  color: rgba(232, 251, 255, 0.92);
  font-size: 0.72rem;
  font-weight: 900;
}

.layerMatrix,
.proofSection,
.guardSection {
  position: relative;
  margin-top: clamp(3rem, 7vw, 7rem);
}

.sectionHeader,
.proofIntro,
.guardCore {
  max-width: 58rem;
  margin-bottom: 1.6rem;
}

.sectionHeader h2,
.proofIntro h2,
.guardCore h2 {
  font-size: clamp(2.35rem, 5vw, 5.4rem);
}

.proofIntro span {
  display: block;
  margin-top: 1rem;
  color: var(--aeon-muted);
  font-size: 1.02rem;
  line-height: 1.75;
}

.layerGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 1rem;
}

.layerCard {
  position: relative;
  min-height: 25rem;
  padding: 1.1rem;
  overflow: hidden;
  border: 1px solid rgba(0, 234, 255, 0.26);
  background:
    radial-gradient(circle at 50% 0%, rgba(0, 234, 255, 0.18), transparent 38%),
    linear-gradient(180deg, rgba(4, 20, 45, 0.84), rgba(1, 8, 21, 0.92));
  clip-path: polygon(12% 0, 100% 0, 100% 88%, 88% 100%, 0 100%, 0 12%);
  box-shadow:
    inset 0 0 32px rgba(0, 234, 255, 0.1),
    0 22px 60px rgba(0, 0, 0, 0.28);
}

.layerCard::before {
  content: "";
  position: absolute;
  inset: -30%;
  background: conic-gradient(
    from calc(var(--i) * 24deg),
    transparent,
    rgba(0, 234, 255, 0.22),
    transparent,
    rgba(21, 119, 255, 0.2),
    transparent
  );
  animation: slowRotate 18s linear infinite;
  opacity: 0.32;
}

.layerCard::after {
  content: "";
  position: absolute;
  inset: 1px;
  background:
    linear-gradient(180deg, rgba(2, 16, 37, 0.72), rgba(1, 8, 20, 0.96)),
    repeating-linear-gradient(
      0deg,
      transparent 0 11px,
      rgba(0, 234, 255, 0.04) 12px
    );
  clip-path: inherit;
  z-index: 0;
}

.layerCard > * {
  position: relative;
  z-index: 1;
}

.layerIndex {
  color: rgba(0, 234, 255, 0.3);
  font-size: clamp(3.3rem, 5vw, 5.4rem);
  font-weight: 1000;
  letter-spacing: -0.08em;
  line-height: 0.82;
}

.layerLabel {
  display: block;
  margin-top: 2rem;
  color: var(--aeon-cyan);
  font-size: 0.66rem;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.layerCard h3 {
  margin: 0.6rem 0 0;
  color: var(--aeon-text);
  font-size: clamp(1.25rem, 1.8vw, 1.72rem);
  line-height: 1.05;
  text-transform: uppercase;
}

.layerCard p {
  margin: 1rem 0 0;
  color: var(--aeon-muted);
  font-size: 0.92rem;
  line-height: 1.72;
}

.layerCard strong {
  position: absolute;
  left: 1.1rem;
  right: 1.1rem;
  bottom: 1rem;
  padding-top: 0.8rem;
  color: var(--aeon-cyan);
  font-size: 0.72rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  border-top: 1px solid rgba(0, 234, 255, 0.18);
}

.proofSection {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(1.5rem, 4vw, 4rem);
  align-items: stretch;
  padding: clamp(1.1rem, 2vw, 2rem);
  border: 1px solid rgba(0, 234, 255, 0.22);
  background:
    linear-gradient(90deg, rgba(0, 234, 255, 0.08), transparent),
    rgba(2, 11, 27, 0.58);
  box-shadow:
    inset 0 0 50px rgba(0, 234, 255, 0.08),
    0 22px 72px rgba(0, 0, 0, 0.24);
}

.proofGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.proofCard {
  position: relative;
  min-height: 12rem;
  padding: 1rem;
  border: 1px solid rgba(0, 234, 255, 0.22);
  background:
    radial-gradient(circle at 100% 0%, rgba(0, 234, 255, 0.16), transparent 44%),
    rgba(1, 8, 19, 0.74);
  clip-path: polygon(10% 0, 100% 0, 100% 82%, 90% 100%, 0 100%, 0 18%);
}

.proofCard span {
  color: var(--aeon-cyan);
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.proofCard strong {
  display: block;
  margin-top: 1.1rem;
  color: var(--aeon-text);
  font-size: clamp(1.7rem, 3vw, 3rem);
  line-height: 0.9;
  text-transform: uppercase;
}

.proofCard p {
  margin: 1rem 0 0;
  color: var(--aeon-muted);
  font-size: 0.92rem;
  line-height: 1.65;
}

.guardSection {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: clamp(1.5rem, 4vw, 4rem);
  align-items: start;
}

.guardList {
  display: grid;
  gap: 0.8rem;
}

.guardItem {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.9rem;
  align-items: start;
  padding: 1rem;
  border: 1px solid rgba(0, 234, 255, 0.18);
  background:
    linear-gradient(90deg, rgba(0, 234, 255, 0.09), transparent),
    rgba(2, 12, 28, 0.68);
}

.guardItem span {
  width: 0.78rem;
  aspect-ratio: 1;
  margin-top: 0.36rem;
  border-radius: 50%;
  background: var(--aeon-cyan);
  box-shadow:
    0 0 14px var(--aeon-cyan),
    0 0 30px rgba(0, 234, 255, 0.5);
}

.guardItem p {
  margin: 0;
  color: rgba(232, 251, 255, 0.84);
  font-weight: 760;
  line-height: 1.55;
}

@keyframes slowRotate {
  to {
    transform: rotate(360deg);
  }
}

@keyframes reverseRotate {
  to {
    transform: rotate(-360deg);
  }
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.58;
    transform: scale(0.97);
  }

  50% {
    opacity: 0.88;
    transform: scale(1.03);
  }
}

@keyframes scanMove {
  0% {
    transform: translateY(-40%);
  }

  50% {
    transform: translateY(130%);
  }

  100% {
    transform: translateY(-40%);
  }
}

@keyframes panelFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-0.4rem);
  }
}

@media (max-width: 1180px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .heroCopy h1 {
    max-width: 16ch;
  }

  .nexusVisual {
    min-height: 46rem;
  }

  .layerGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .layerCard {
    min-height: 21rem;
  }
}

@media (max-width: 820px) {
  .inner {
    width: min(100% - 1.1rem, 1440px);
    padding: 2.2rem 0;
  }

  .heroCopy {
    padding: 0.35rem;
  }

  .heroCopy h1 {
    font-size: clamp(2.55rem, 14vw, 4.4rem);
  }

  .nexusVisual {
    min-height: 33rem;
  }

  .coreStage {
    inset: 0;
  }

  .signalRail {
    display: none;
  }

  .corePanel {
    width: min(78vw, 23rem);
    min-width: 0;
  }

  .orbitOne {
    width: min(92vw, 30rem);
  }

  .orbitTwo {
    width: min(76vw, 24rem);
  }

  .orbitThree {
    width: min(58vw, 18rem);
  }

  .hexLeft {
    left: 0;
  }

  .hexRight {
    right: 0;
  }

  .nodeDock {
    display: none;
  }

  .layerGrid,
  .proofSection,
  .proofGrid,
  .guardSection {
    grid-template-columns: 1fr;
  }

  .layerCard {
    min-height: 18.5rem;
  }

  .proofSection {
    padding: 1rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .architecturePage::after,
  .scanLayer,
  .energyBurst,
  .orbitOne,
  .orbitTwo,
  .orbitThree,
  .layerCard::before,
  .signalCard {
    animation: none;
  }
}
